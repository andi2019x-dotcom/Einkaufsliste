rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ok() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'andi.2019.x@gmail.com','claudi.2024.x@gmail.com',
          'carlotta.seltmann@gmail.com','emma.seltmann@gmail.com'];
    }
    function titleOk() { return request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200; }
    match /users/{u} {
      allow read: if ok();
      allow create, update: if ok() && request.auth.uid == u;
    }
    // Tageszettel (cat food/drug) und freie Zettel (cat free: name, archived, deleted). NEU in 3.0.0: update (Umbenennen, Archivieren, Löschen-Markierung)
    match /lists/{l} {
      allow read: if ok();
      allow create, update: if ok();
    }
    match /items/{i} {
      allow read: if ok();
      allow create: if ok() && titleOk() && request.resource.data.createdBy == request.auth.uid;
      allow update: if ok() && titleOk();
      // endgültiges Löschen nur, wenn seit dem Löschzeitpunkt mindestens 30 Tage vergangen sind (serverseitig)
      allow delete: if ok() && resource.data.deletedAt is timestamp
        && resource.data.deletedAt < request.time - duration.value(30, 'd');
    }
    // Sammlungen seit Version 2.1.0 (Sortierung nach Laden)
    match /pcats/{c} { allow read, write: if ok(); }
    match /stores/{s} { allow read, write: if ok(); }
    match /products/{p} { allow read, write: if ok(); }
    match /config/{c} { allow read, create, update: if ok(); }
  }
}
